# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real keys.

# --- Clerk auth (get from https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- OpenAI (used by the AI question + feedback routes) ---
# https://platform.openai.com/api-keys  — model used: gpt-4o-mini
OPENAI_API_KEY=sk-xxx

# --- Public site URL (used for SEO metadata, sitemap, robots) ---
# Set to your deployed origin in production, e.g. https://mockoffer.live
NEXT_PUBLIC_SITE_URL=http://localhost:3000
